  ],
  "transformations": [
    {
      "path": "packages/reader-core/src/agent-export/agent-export.test.mjs",
      "operation": "keep-generic-tests-only",
      "keptTests": [
        "book and section ids become safe, distinct path segments; unusable ids are refused",
        "prompts point at the book and chapter addresses and ask for citations; the attached prompt names no address",
        "Markdown is exported verbatim, including trailing newlines, spaces and a code hard break",
        "the directory option is validated by both generators before any path is produced",
        "a nested directory keeps every reader link pointing at the reader root",
        "reader chapter references resolve to exported chapter files in chapter and full-book contexts",
        "Markdown reader references stay verbatim; resolved files are listed in a note after the section",
        "whitespace-only Markdown keeps its bytes; only an empty string gets the structural explanation",
        "canonicalSiteUrl applies the exact-URL rules to the raw value before the URL parser can repair it",
        "private-host aliases are private: final DNS dots, numeric IPv4 forms and IPv4 inside IPv6",
        "both generators refuse an unusable public address before producing any file, and never echo it",
        "the reader box rebases its folder from the current reader root onto the public reader prefix",
        "a folder given as its full public address: downloads under the current reader root, the prompt under siteUrl, whatever the two prefixes are",
        "an unsafe or out-of-scope folder is ignored for the default folder; it never becomes an active link",
        "a private or malformed configured address is ignored: no private address reaches a hosted-fetch prompt"
      ],
      "droppedTests": [
        "every book: all section ids in reading order, counts, and one file per section",
        "markdown sections are preserved byte for byte in chapter files and, in order, in full.md",
        "code, tables, footnote-like attribution, source lines and the image link survive",
        "html sections keep their structure through the reader sanitiser, with a title heading added",
        "every relative link in every generated file resolves to a generated file; no private paths or browser state",
        "siteUrl makes every link absolute; relative output has none of that host",
        "reader links match the reader\\'s own publicationUrl; private hosts are recognised",
        "canonicalSiteUrl accepts only public http(s) addresses and normalises the trailing slash",
        "a root index links each book at its own public address, never at another book\\'s",
        "anchored reading: leadLength is WriteFlex\\'s own, and lead spans follow its word walk",
        "real Language Muscle step-2 links to the Fine-tuning your aims chapter file"
      ],
