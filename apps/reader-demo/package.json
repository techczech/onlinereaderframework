{
  "name": "reader-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/build-agent-files.ts",
    "preview": "vite preview",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "build:llms": "tsx scripts/build-llms.ts",
    "check": "tsc --noEmit",
    "import:originals": "tsx scripts/import-original-books.ts",
    "test:books": "tsx --test scripts/test-original-books.ts scripts/test-demo-books.ts",
    "verify:originals": "tsx scripts/verify-original-source-snapshots.ts",
    "build:agent": "tsx scripts/build-agent-files.ts",
    "build:release": "tsx scripts/build-release.ts",
    "test:release": "tsx --test scripts/release/test-release.ts scripts/release/test-release-repair.ts scripts/release/test-release-write.ts",
    "verify:release": "tsx scripts/release/verify-existing-edition.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/material-symbols-outlined": "5.3.9",
    "@fontsource/merriweather": "5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reader-core": "file:../../packages/reader-core"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.1"
  }
}
