{
  "name": "reader-core",
  "version": "1.1.0",
  "description": "Reader components, publication rendering, EPUB and agent-file generation for the Online Reader Framework.",
  "license": "MIT",
  "author": "Dominik Lukeš",
  "homepage": "https://techczech.github.io/onlinereaderframework/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techczech/onlinereaderframework.git",
    "directory": "packages/reader-core"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent-export/index.d.ts",
      "default": "./dist/agent-export/index.js"
    },
    "./embed-child": {
      "types": "./dist/embed/embed-child.d.ts",
      "default": "./dist/embed/embed-child.js"
    },
    "./reader.css": "./dist/reader.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-reader-core.mjs",
    "test:publication-content": "node src/publication-content/test-publication-content.mjs",
    "test:agent-export": "node src/agent-export/test-agent-export.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.2.0",
    "react-dom": "^18.3.1 || ^19.2.0"
  },
  "dependencies": {
    "@mdit/plugin-katex": "1.1.3",
    "hast-util-from-html": "2.0.3",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-text": "4.0.2",
    "jszip": "^3.10.1",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/material-symbols-outlined": "5.3.9",
    "@tailwindcss/typography": "0.5.20",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.30",
    "autoprefixer": "10.6.1"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  }
}
