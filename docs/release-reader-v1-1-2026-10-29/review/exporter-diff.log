+/** Before a candidate of a new release replaces the outputs, copy the previous candidate and its four files into build/retired-reader-source-<status>-<hash>/.
+ * Same status: a rerun of this release, nothing to keep. An existing retired folder must hold the same archive; nothing is overwritten. */
+function retirePreviousCandidate(status, buildRoot = build, owner = root) {
+  const manifestPath = resolve(buildRoot, 'reader-source-release.manifest.json');
+  if (!existsSync(manifestPath)) return null;
+  assertProjectPath(manifestPath, 'file', owner);
+  const previous = JSON.parse(readFileSync(manifestPath, 'utf8'));
+  if (previous.status === status) return null;
+  assert.match(previous.status ?? '', /^[a-z0-9.-]+$/, 'Unexpected previous candidate status');
+  assert.match(previous.sha256 ?? '', /^[a-f0-9]{64}$/);
+  const archivePath = resolve(buildRoot, 'reader-source-release.tar.gz');
+  assertProjectPath(archivePath, 'file', owner);
+  assert.equal(hash(readFileSync(archivePath)), previous.sha256, 'Previous archive does not match its manifest; refusing to retire or replace it');
+  const destination = resolve(buildRoot, `retired-reader-source-${previous.status}-${previous.sha256.slice(0, 12)}`);
+  assertProjectPath(destination, 'any', owner);
+  if (existsSync(destination)) {
+    assertProjectPath(resolve(destination, 'reader-source-release.tar.gz'), 'file', owner);
+    assert.equal(hash(readFileSync(resolve(destination, 'reader-source-release.tar.gz'))), previous.sha256, 'Retired folder exists with another archive');
+    return { path: relative(owner, destination), sha256: previous.sha256, status: previous.status, alreadyRetired: true };
+  }
+  mkdirSync(destination);
+  assertProjectPath(destination, 'directory', owner);
+  for (const name of OUTPUT_NAMES) {
+    const source = resolve(buildRoot, name);
+    if (!existsSync(source)) continue;
+    assertProjectPath(source, 'file', owner);
+    writeFileSync(resolve(destination, name), readFileSync(source));
+  }
+  const previousCandidate = resolve(buildRoot, 'public-reader-source');
+  let copied = 0;
+  if (existsSync(previousCandidate)) {
+    assertProjectPath(previousCandidate, 'directory', owner);
+    const listed = new Map(previous.files.map(file => [file.path, file.sha256]));
+    (function copyTree(from, at) {
+      for (const entry of readdirSync(from, { withFileTypes: true })) {
+        const path = posix.join(at, entry.name), full = resolve(from, entry.name), target = resolve(destination, 'public-reader-source', path);
+        assert.ok(!entry.isSymbolicLink(), 'Link in previous candidate');
+        if (entry.isDirectory()) { copyTree(full, path); continue; }
+        assert.ok(entry.isFile(), 'Unexpected previous candidate member');
+        const bytes = readFileSync(full);
+        assert.equal(hash(bytes), listed.get(path), `Previous candidate member differs from its manifest: ${path}`);
+        mkdirSync(dirname(target), { recursive: true });
+        assertProjectPath(target, 'file', owner);
+        writeFileSync(target, bytes); copied++;
+      }
+    })(previousCandidate, '');
+    assert.equal(copied, listed.size, 'Previous candidate is incomplete');
+  }
+  return { path: relative(owner, destination), sha256: previous.sha256, status: previous.status, candidateFiles: copied };
+}
