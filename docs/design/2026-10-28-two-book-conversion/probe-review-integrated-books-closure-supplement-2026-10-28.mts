const root=process.cwd(),review=path.dirname(fileURLToPath(import.meta.url)),app=path.join(root,'apps/reader-demo'),books=path.join(app,'src/books/next-books');const scratch=fs.mkdtempSync(path.join(review,'.scratch-closure-supplement-'));const output:any={date:new Date().toISOString(),checks:[],commands:[],exports:[]};const hash=(x:any)=>createHash('sha256').update(x).digest('hex');const check=(name:string,ok:boolean,detail:any={})=>{output.checks.push({name,ok,detail});if(!ok)console.log('FAIL',name);};let chrome:any,ws:any;
